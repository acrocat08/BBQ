  m_Text: "\u3042\u306A\u305F\u304C\u8A2D\u5B9A\u3057\u305F\u98DF\u6750\u306E\u30E9\u30A4\u30F3\u30CA\u30C3\u30D7\u3067\u904A\u3076\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u597D\u304D\u306A\u98DF\u6750\u3092\u5165\u308C\u308B\u3082\u3088\u3057\u3001\u6700\u5F37\u306E\u7D44\u307F\u5408\u308F\u305B\u3092\u8003\u3048\u308B\u3082\u3088\u3057\u3002\u4F7F\u3044\u65B9\u306F\u81EA\u7531\u3067\u3059\u3002\n\n\u203B\u30D9\u30B9\u30C8\u30B9\u30B3\u30A2\u306F\u66F4\u65B0\u3055\u308C\u307E\u305B\u3093"
